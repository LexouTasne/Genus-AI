# Copie para .env e preencha. Nunca faça commit deste arquivo.
OPENROUTER_API_KEY=
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GENUS_LOCAL_API_TOKEN=
GENUS_LOCAL_API_HOST=127.0.0.1
GENUS_LOCAL_API_PORT=7532

# Recursos perigosos permanecem desligados. Habilite apenas em ambiente isolado.
GENUS_ALLOW_SYSTEM_TOOLS=false
GENUS_ALLOWED_COMMANDS=pwd,ls,date,whoami
GENUS_ALLOW_CODE_EXECUTION=false
GENUS_ENABLE_AUTONOMY=false
